{
  "name": "ata-lta-erp-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "ATA & LTA ERP monorepo \u2014 backend API and SPA frontend",
  "scripts": {
    "dev": "node scripts/dev.js local",
    "dev:staging": "node scripts/dev.js staging",
    "dev:prod": "node scripts/dev.js prod",
    "dev:main": "node scripts/dev.js main",
    "dev:backend": "cd backend && npm run dev:local",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:stack": "docker compose -f docker-compose.dev.yml up --build",
    "dev:stack:stop": "docker compose -f docker-compose.dev.yml down",
    "setup": "node scripts/setup-env.js",
    "migrate:remote": "cd backend && npm run migrate:remote",
    "migrate:remote:staging": "cd backend && npm run migrate:remote:staging",
    "migrate:staging:remote": "cd backend && npm run migrate:staging:remote",
    "migrate:remote:prod": "cd backend && npm run migrate:remote:prod",
    "migrate:remote:main": "cd backend && npm run migrate:remote:main",
    "create-bucket": "cd backend && npm run create-bucket",
    "create-bucket:prod": "cd backend && npm run create-bucket:prod",
    "create-bucket:main": "cd backend && npm run create-bucket:main",
    "clear-data:remote": "cd backend && npm run clear-data:remote",
    "clear-data-all-users:remote": "cd backend && npm run clear-data-all-users:remote",
    "smoke": "node scripts/smoke-react.js",
    "smoke:staging": "node scripts/smoke-react.js staging",
    "build:spa": "npm --prefix frontend run build",
    "build:spa:staging": "node scripts/build-frontend.js staging",
    "build:spa:prod": "node scripts/build-frontend.js prod",
    "build:spa:main": "node scripts/build-frontend.js main",
    "keep-alive": "node scripts/keep-alive.js",
    "install:all": "npm install && npm --prefix backend install && npm --prefix frontend install",
    "smoke:prod": "node scripts/smoke-react.js prod",
    "smoke:main": "node scripts/smoke-react.js main",
    "test:tooling": "node --test scripts/tests/*.test.js"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
