NODE_ENV=production
PORT=3000

# Supabase — Main/Production deployment target.
# Values are injected by Render from the erp-main-secrets environment group.
SUPABASE_URL=${SUPABASE_URL}
SUPABASE_SERVICE_KEY=${SUPABASE_SERVICE_KEY}
SUPABASE_STORAGE_BUCKET=${SUPABASE_STORAGE_BUCKET:-ata-lta-erp-documents-prod}

# PostgreSQL — Main/Production direct connection.
DATABASE_URL=${DATABASE_URL}

# Frontend — Render Static Site origin for Main.
FRONTEND_URL=${FRONTEND_URL:-https://ata-lta-erp-spa-main.onrender.com}

# Logging
LOG_LEVEL=info

# Receipt Reservation Storage Driver
# database (recommended for Render without persistent disk) | filesystem (requires persistent volume)
RESERVATION_STORE_DRIVER=database
